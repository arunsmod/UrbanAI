# URBANAi Environment Configuration
# Copy this file to .env and fill in actual values for your environment

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Machine Learning Model
MODEL_PATH=./backend/data/flood_risk_model.joblib
DATA_PATH=./backend/data/flood_data.csv

# Security (add for production)
SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_EMAIL=admin@urbanai.gov
# Generate a PBKDF2 hash for production; do not commit the real value.
ADMIN_PASSWORD_HASH=
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_OPTIONAL=false

# Deployment
# Set this to the public Render API URL in Netlify.
# VITE_API_URL=https://your-api.onrender.com

# Feature Flags
ENABLE_LOGGING=true
ENABLE_VALIDATION=true
